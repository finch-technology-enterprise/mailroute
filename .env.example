# =============================================================================
# mailroute — Environment Variables
# =============================================================================
# Copy this file to .env or .dev.vars and fill in your values.
#   cp .env.example .dev.vars
#
# Secrets are deployed to Cloudflare Workers via:
#   wrangler secret put API_AUTH_KEY
# Or using the deploy-secret script:
#   npm run deploy-secret
# =============================================================================

# REQUIRED: Cloudflare account ID. Wrangler reads this automatically
# when omitted from wrangler.jsonc.
CLOUDFLARE_ACCOUNT_ID=your-cloudflare-account-id

# REQUIRED: JWT secret for signing authentication tokens (multi-tenant mode).
# Generate with: openssl rand -base64 32
JWT_SECRET=your-jwt-secret

# REQUIRED: API authentication key. Requests must include this value
# in the X-API-AUTH-KEY header (legacy single-tenant mode).
API_AUTH_KEY=your-secret-api-auth-key

# REQUIRED: New Relic license key for observability logging (set as Worker secret).
# Works globally across all tenants — independent of D1 config.
NEW_RELIC_LICENSE_KEY=your-new-relic-license-key

# New Relic Log API endpoint (set as Worker secret).
# Defaults to https://log-api.newrelic.com/log/v1 if omitted.
NEW_RELIC_LOG_ENDPOINT=https://log-api.newrelic.com/log/v1

# Environment name. Used as a tag in observability logs.
# Values: production, staging, development
APP_ENVIRONMENT=development

# Public URL of the application (used as a fallback in config resolution).
APP_URL=https://mailroute.example.com

# Timezone for date formatting (default: Asia/Kuala_Lumpur).
TIMEZONE=Asia/Kuala_Lumpur

# ---------------------------------------------------------------------------
# DEPRECATED — Vendor credentials now live in the email_vendors D1 table.
# These are read only as a fallback until the table is seeded.
# ---------------------------------------------------------------------------
# SENDER_API_ENDPOINT=https://api.sender.net/v2/...
# SENDER_API_TOKEN=your-sender-net-token
