{
  "name": "mailroute",
  "license": "MIT",
  "private": true,
  "type": "module",
  "workspaces": [
    "admin"
  ],
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy --minify",
    "deploy-secret": "./scripts/deploy-secrets.sh",
    "cf-typegen": "wrangler types --env-interface CloudflareBindings",
    "build": "tsc --noEmit",
    "test": "npm run test:unit && npm run test:worker",
    "test:unit": "vitest run --config vitest.config.ts",
    "test:worker": "vitest run --config vitest.worker.config.ts",
    "test:watch": "vitest --config vitest.config.ts",
    "ci": "npm run build:admin && npm run build",
    "format": "prettier --write .",
    "format:check": "node scripts/check-format.mjs",
    "dev:admin": "npm run dev --workspace=admin",
    "build:admin": "npm run build --workspace=admin",
    "migrate:local": "wrangler d1 execute D1_DATABASE --local --file",
    "migrate:remote": "wrangler d1 execute D1_DATABASE --remote --file",
    "db:seed:local": "wrangler d1 execute D1_DATABASE --local --file scripts/seed-email-vendors.sql",
    "db:seed:remote": "wrangler d1 execute D1_DATABASE --remote --file scripts/seed-email-vendors.sql",
    "test:e2e": "npx playwright test --config e2e/playwright.config.ts",
    "test:e2e:ui": "npx playwright test --ui --config e2e/playwright.config.ts",
    "test:e2e:report": "npx playwright show-report playwright-report"
  },
  "dependencies": {
    "@hono/zod-validator": "^0.9.0",
    "drizzle-orm": "^0.45.2",
    "hono": "^4.12.31",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "^0.18.8",
    "@cloudflare/workers-types": "^5.20260727.1",
    "@playwright/test": "^1.62.0",
    "drizzle-kit": "^0.31.10",
    "prettier": "^3.9.5",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10",
    "wrangler": "^4.112.0"
  },
  "overrides": {
    "glob": "13.0.6"
  }
}
